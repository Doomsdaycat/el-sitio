{
  "name": "brumeland-vtt",
  "version": "0.8.0",
  "private": true,
  "description": "Table de jeu virtuelle maison pour jouer à Dragonbane entre amis",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "partie": "npm run -s compiler && tsx --disable-warning=ExperimentalWarning server/partie-en-ligne.ts",
    "start": "npm run -s compiler && npm run -s serveur",
    "compiler": "vite build --logLevel warn",
    "serveur": "NODE_ENV=production sh -c 'while :; do tsx --disable-warning=ExperimentalWarning server/index.ts; c=$?; [ $c -eq 75 ] || exit $c; done'",
    "lien-mj": "NODE_ENV=production tsx --disable-warning=ExperimentalWarning server/lien-mj.ts",
    "sauvegardes": "tsx --disable-warning=ExperimentalWarning server/sauvegardes-commande.ts liste",
    "restaurer": "tsx --disable-warning=ExperimentalWarning server/sauvegardes-commande.ts restaurer",
    "mettre-en-ligne": "tsx --disable-warning=ExperimentalWarning server/mettre-en-ligne.ts",
    "dev": "concurrently --names serveur,interface --prefix-colors yellow,cyan \"npm:dev:serveur\" \"npm:dev:interface\"",
    "dev:serveur": "tsx watch --disable-warning=ExperimentalWarning server/index.ts",
    "dev:interface": "vite",
    "verifier": "tsc --noEmit -p tsconfig.json",
    "tester": "tsx --test server/*.test.ts"
  },
  "dependencies": {
    "express": "^5.3.0",
    "fflate": "^0.8.3",
    "konva": "^10.9.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-konva": "^19.3.2",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
